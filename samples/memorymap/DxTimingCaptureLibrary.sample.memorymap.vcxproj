<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{D519BA6D-0853-4333-9A41-B126FAE0AB93}</ProjectGuid>
    <ConfigurationType>Application</ConfigurationType>
    <TargetName>DxTimingCaptureLibrary.sample.memorymap</TargetName>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <AdditionalIncludeDirectories>
        %(AdditionalIncludeDirectories);
        $(PixEventDecoderPath)\include;
        $(ImguiPath);
        $(ImguiPath)\backends;
      </AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <EntryPointSymbol>wmainCRTStartup</EntryPointSymbol>
      <AdditionalDependencies>
        %(AdditionalDependencies);
        onecore.lib;
        uuid.lib;
        d3d11.lib;
        dxgi.lib;
        d3dcompiler.lib;
      </AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="pch.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="main.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="EtwConfig.h" />
    <ClInclude Include="MemoryMapCallbacks.h" />
    <ClInclude Include="MemoryModel.h" />
    <ClInclude Include="pch.h" />
    <ClInclude Include="Treemap.h" />
  </ItemGroup>
  <ItemGroup>
    <!-- In a UsePixUtility build, EtwException.h resolves to PIX's
         WinPix::ToolException (see DxTimingCaptureLibrary/EtwException.h), whose out-of-line
         symbols live in PixUtility.lib. A standalone build of the library uses the
         self-contained EtwException and does not need this reference. -->
    <ProjectReference Condition="'$(UsePixUtility)' == 'true'" Include="$(PixUtilityRoot)\lib\PixUtility.vcxproj">
      <Project>{6591c7c3-cf78-4150-992d-5e0c0d13e609}</Project>
    </ProjectReference>
    <ProjectReference Condition="'$(UseStubPixEventDecoder)' != 'true'" Include="$(PixEventDecoderPath)\lib\PixEventDecoder.lib.vcxproj">
      <Project>{750cf23a-1b4a-4f62-acb7-45fe8b78a7a7}</Project>
    </ProjectReference>
    <ProjectReference Include="$(DxTimingCaptureLibraryRoot)\lib\DxTimingCaptureLibrary.lib.vcxproj">
      <Project>{bd5d2df6-a412-48d8-a0c9-d220dccb92d3}</Project>
    </ProjectReference>
    <ProjectReference Include="$(ImguiPath)\imgui.vcxproj">
      <Project>{78f5bf88-35fc-4c4b-9c88-b8d03b6fdd7b}</Project>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
